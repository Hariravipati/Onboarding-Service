          }
        },
        {
          "name": "Get candidates by QC status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/offer-letter/candidates/qc-status/PASS",
              "host": ["{{base_url}}"],
              "path": ["offer-letter", "candidates", "qc-status", "PASS"]
            }
          }
        }
      ]
    },
    {
      "name": "Candidate Verification",
      "item": [
        {
          "name": "Verify candidate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": 1,\n  \"panNumber\": \"ABCDE1234F\",\n  \"aadhaarNumber\": \"123456789012\",\n  \"accountNumber\": \"1234567890\",\n  \"ifsc\": \"HDFC0001234\",\n  \"accountHolderName\": \"Jane Doe\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/candidate-verification/verify",
              "host": ["{{base_url}}"],
              "path": ["candidate-verification", "verify"]
            }
          }
        },
        {
          "name": "Get candidate verification results",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/candidate-verification/candidates/1/results",
              "host": ["{{base_url}}"],
              "path": ["candidate-verification", "candidates", "1", "results"]
            }
          }
        },
        {
          "name": "Get verification audit trail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/candidate-verification/abc123/audit",
              "host": ["{{base_url}}"],
              "path": ["candidate-verification", "abc123", "audit"]
            }
          }
        },
        {
          "name": "Retry verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/candidate-verification/abc123/retry",
              "host": ["{{base_url}}"],
              "path": ["candidate-verification", "abc123", "retry"]
            }
          }
        },
        {
          "name": "Override verification",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" },
              { "key": "x-user-id", "value": "admin@example.com" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PASS\",\n  \"remarks\": \"Manual override approved\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/candidate-verification/abc123/override",
              "host": ["{{base_url}}"],
              "path": ["candidate-verification", "abc123", "override"]
