    {
      "name": "Offer Letter",
      "item": [
        {
          "name": "Get submitted candidates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/offer-letter/candidates?status=SUBMITTED&qcStatus=PASS",
              "host": ["{{base_url}}"],
              "path": ["offer-letter", "candidates"],
              "query": [
                { "key": "status", "value": "SUBMITTED" },
                { "key": "qcStatus", "value": "PASS" }
              ]
            }
          }
        },
        {
          "name": "Get candidate offer letter details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{x_tenant_id}}" }
